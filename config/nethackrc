# Autopickup
# ------------------

OPTIONS=autopickup
OPTIONS=pickup_burden:B
OPTIONS=pickup_thrown
OPTIONS=pickup_types:$"%/*

AUTOPICKUP_EXCEPTION="<wand .* wish"
AUTOPICKUP_EXCEPTION="<wand .* create monster"
AUTOPICKUP_EXCEPTION="<wand .* tele"
AUTOPICKUP_EXCEPTION="<wand .* poly"
AUTOPICKUP_EXCEPTION="<wand .* fire"
AUTOPICKUP_EXCEPTION="<wand .* lightning"
AUTOPICKUP_EXCEPTION="<wand .* death"

AUTOPICKUP_EXCEPTION="> corpse"
AUTOPICKUP_EXCEPTION="<lichen corpse" 
AUTOPICKUP_EXCEPTION="<lizard corpse" 
AUTOPICKUP_EXCEPTION="<newt corpse"
AUTOPICKUP_EXCEPTION="<floating eye corpse"
AUTOPICKUP_EXCEPTION="<wraith corpse"

AUTOPICKUP_EXCEPTION="<magic marker"
AUTOPICKUP_EXCEPTION="< lamp"
AUTOPICKUP_EXCEPTION="> oil lamp"
AUTOPICKUP_EXCEPTION="> lamp .* oil"
AUTOPICKUP_EXCEPTION="<amulet .* life"
AUTOPICKUP_EXCEPTION="<athame"

AUTOPICKUP_EXCEPTION="> loadstone"
AUTOPICKUP_EXCEPTION="<stone called luck"
AUTOPICKUP_EXCEPTION="< luckstone"
AUTOPICKUP_EXCEPTION="> rock"
AUTOPICKUP_EXCEPTION="> gray stone"
AUTOPICKUP_EXCEPTION=">^[a0-9]+ stone"
AUTOPICKUP_EXCEPTION=">worthless"

AUTOPICKUP_EXCEPTION=">scroll .* scare monster"
AUTOPICKUP_EXCEPTION=">:0)"
AUTOPICKUP_EXCEPTION=">wand .* cold$"
AUTOPICKUP_EXCEPTION=" named empty"
AUTOPICKUP_EXCEPTION=" nothing"

# Customization
# ------------------

OPTIONS=pettype:cat
OPTIONS=catname:cowardcat
OPTIONS=dogname:dumbdog
OPTIONS=horsename:hideoushorse

# Curses
# ------------------

OPTIONS=windowtype:curses
OPTIONS=align_message:top,align_status:bottom
OPTIONS=popup_dialog
OPTIONS=selectsaved
OPTIONS=splash_screen
OPTIONS=windowborders:2
OPTIONS=petattr:underline
OPTIONS=guicolor

# General
# ------------------

OPTIONS=acoustics,autodescribe,!tutorial,number_pad:0
OPTIONS=!tips
OPTIONS=!autodig,autoopen,!autoquiver
OPTIONS=!blind,!nudist
OPTIONS=!bones,checkpoint,!legacy,!mail,!news
OPTIONS=!cmdassist,!extmenu,!herecmd_menu
OPTIONS=travel
OPTIONS=confirm,safe_pet,paranoid_confirmation:all
OPTIONS=tombstone

OPTIONS=dark_room,hilite_pet,hilite_pile,lit_corridor,sparkle
OPTIONS=runmode:teleport

OPTIONS=packorder:$"=)[%?!/(+*`0_
OPTIONS=fixinv,force_invmenu,perm_invent,perminv_mode:full
OPTIONS=menustyle:full
OPTIONS=sortloot:full,sortpack

# Keybinds
# ------------------

BIND=!:loot,^v:untrap

