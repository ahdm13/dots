# Autopickup
# ------------------

OPTIONS=autopickup
OPTIONS=pickup_burden:B
OPTIONS=pickup_thrown
OPTIONS=pickup_types:$"%/*

AUTOPICKUP_EXCEPTION="<wand .* wish"
AUTOPICKUP_EXCEPTION="<wand .* create monster"
